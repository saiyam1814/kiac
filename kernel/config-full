# kiac "full" kernel config fragment.
#
# Applied on top of apple/containerization's kernel/config-arm64 (pinned
# ref in .github/workflows/kernel-build.yml) with the kernel tree's
# scripts/kconfig/merge_config.sh, then `make olddefconfig`. Everything
# is =y: Apple's base sets "# CONFIG_MODULES is not set" (fully
# monolithic, no module loading at runtime) and this fragment keeps
# that model, so any feature a CNI would normally modprobe must be
# built in here.
#
# Options already =y in Apple's base are re-asserted on purpose: the
# workflow fails if any line below is missing from the final .config,
# so upstream base-config drift can never silently regress a CNI
# requirement. Each option cites its consumer; Cilium options come from
# docs.cilium.io "System Requirements"
# (Documentation/operations/system_requirements.rst, fetched 2026-07-06).

# --- Cilium base eBPF requirements ------------------------------------
# Consumer: Cilium agent datapath (all modes).
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
# BPF_EVENTS depends on TRACING plus a probe-event backend
# ((KPROBE_EVENTS || UPROBE_EVENTS) in kernel/trace/Kconfig); without
# these, olddefconfig silently drops it and the CI guard fails the
# build. Cilium attaches to kprobes/tracepoints for several features.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# JIT is mandatory for Cilium and absent from Apple's base config file
# (their build relies on olddefconfig defaults); pinned explicitly.
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
# BTF: Apple's base sets CONFIG_DEBUG_INFO_NONE=y, which blocks
# CONFIG_DEBUG_INFO_BTF. Flip to toolchain-default DWARF so BTF can be
# emitted; the build container must ship pahole (dwarves package).
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_PERF_EVENTS=y
CONFIG_SCHEDSTATS=y

# --- Cilium BPF syscall extras (brief: sockmap/AF_XDP datapaths) ------
# Consumer: Cilium sockops/sockmap acceleration and BPF kube-proxy
# replacement paths; also any AF_XDP workload.
CONFIG_BPF_STREAM_PARSER=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y

# --- Cilium tunneling and routing -------------------------------------
# Consumer: Cilium default pod-to-pod tunneling; also flannel's vxlan
# backend and Calico's VXLAN cross-subnet mode.
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_FIB_RULES=y

# --- Cilium iptables-based masquerading (default until BPF masquerade) -
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y

# --- Cilium L7 / FQDN policy (TPROXY redirection) ----------------------
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y

# --- Cilium bandwidth manager and netkit device mode -------------------
CONFIG_NET_SCH_FQ=y
CONFIG_NETKIT=y

# --- WireGuard ---------------------------------------------------------
# Consumer: Cilium transparent encryption and Calico WireGuard mode.
CONFIG_WIREGUARD=y

# --- Bridge-path CNIs and kube-proxy ------------------------------------
# Consumer: kindnet/flannel/Calico bridge datapaths and kubeadm's
# br_netfilter preflight; BRIDGE_NETFILTER is what makes bridged pod
# traffic visible to iptables (net.bridge.bridge-nf-call-iptables).
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y

# --- Extra interface types ----------------------------------------------
# Consumer: multus/whereabouts style secondary networks and CNI plugins
# that attach macvlan/ipvlan interfaces.
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y

# --- Calico ipsets -------------------------------------------------------
# Consumer: Calico felix programs hash:ip, hash:net and hash:ip,port,net
# ipsets for policy; only hash:ip is required by Cilium above.
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORTNET=y
