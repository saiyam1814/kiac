apiVersion: v1
kind: Secret
metadata:
  name: kiac-gpu-compat
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kiac-gpu-compat
    app.kubernetes.io/part-of: kiac
type: kubernetes.io/tls
data:
  tls.crt: {{ .ServerCert }}
  tls.key: {{ .ServerKey }}
---
apiVersion: v1
kind: Service
metadata:
  name: kiac-gpu-compat
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kiac-gpu-compat
    app.kubernetes.io/part-of: kiac
spec:
  selector:
    app.kubernetes.io/name: kiac-gpu-compat
  ports:
    - name: https
      port: 443
      targetPort: https
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kiac-gpu-compat
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kiac-gpu-compat
    app.kubernetes.io/part-of: kiac
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: kiac-gpu-compat
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kiac-gpu-compat
        app.kubernetes.io/part-of: kiac
      annotations:
        kiac.dev/tls-id: {{ .TLSID }}
    spec:
      automountServiceAccountToken: false
      nodeName: {{ .ControlPlane }}
      priorityClassName: system-cluster-critical
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
        - key: node-role.kubernetes.io/master
          operator: Exists
          effect: NoSchedule
      containers:
        - name: webhook
          image: docker.io/library/busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
          imagePullPolicy: IfNotPresent
          command: [/opt/kiac/kiac-gpu-agent]
          args:
            - --mode=webhook
            - --listen=:9443
            - --tls-cert=/var/run/kiac-gpu-compat/tls.crt
            - --tls-key=/var/run/kiac-gpu-compat/tls.key
          ports:
            - name: https
              containerPort: 9443
          readinessProbe:
            httpGet:
              scheme: HTTPS
              path: /healthz
              port: https
            periodSeconds: 2
            timeoutSeconds: 1
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests:
              cpu: 5m
              memory: 12Mi
            limits:
              memory: 48Mi
          volumeMounts:
            - name: agent
              mountPath: /opt/kiac/kiac-gpu-agent
              readOnly: true
            - name: tls
              mountPath: /var/run/kiac-gpu-compat
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: agent
          hostPath:
            path: /usr/local/libexec/kiac/kiac-gpu-agent
            type: File
        - name: tls
          secret:
            secretName: kiac-gpu-compat
            defaultMode: 0444
        - name: tmp
          emptyDir: {}
